## CMake package config file for find_package() support
##
## This file is used by find_package(wjh_slotmap) after installation.
## For FetchContent usage, the wjh::slotmap target is available directly.

@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/wjh_slotmapTargets.cmake")

check_required_components(wjh_slotmap)
